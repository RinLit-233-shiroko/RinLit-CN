---
import { t } from '../../i18n/index';
import Link from '../Link.astro';
import Button from '../Button.astro';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const __ = (key: string) => t(lang, key);
const year = new Date().getFullYear();

const navItems = [
  { label: __('nav.fields'), href: 'fields', meta: __('footer.nav.fields') },
  { label: __('nav.gallery'), href: 'gallery', meta: __('footer.nav.gallery') },
  { label: __('nav.writing'), href: 'writing', meta: __('footer.nav.writing') },
  { label: __('nav.me'), href: 'me', meta: __('footer.nav.me') },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-panel">
      <div class="footer-brand">
        <Link to="" class="footer-logo-link" aria-label="RinLit Home">
          <img
            class="footer-logo footer-logo--light"
            src="/images/logo/Type=Horizontal, Mode=Light, Monochrome=True.png"
            alt="RinLit"
          />
          <img
            class="footer-logo footer-logo--dark"
            src="/images/logo/Type=Horizontal, Mode=Dark, Monochrome=True.png"
            alt="RinLit"
          />
        </Link>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        {navItems.map((item) => (
          <Button to={item.href} flat class="footer-nav-button">{item.label}</Button>
        ))}
      </nav>

      <div class="footer-bottom">
        <div class="footer-legal">
          <p class="footer-copy">
          {__('footer.copyright').replace('{year}', String(year))}
          </p>
          <a
            class="footer-filing"
            href="https://beian.miit.gov.cn/"
            target="_blank"
            rel="noopener noreferrer"
          >
            琼ICP备2026014960号-1
          </a>
        </div>
        <!--<p class="footer-note">{__('footer.note')}</p>-->
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    color: var(--text);
    padding: 72px 24px 124px;
    transition: background 0.25s ease, color 0.25s ease;
  }


  .footer-inner {
    position: relative;
    z-index: 1;
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  .footer-panel {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) auto;
    gap: 20px 40px;
    align-items: center;
    padding: 28px 34px 22px;
    border: 0;
    border-radius: 26px;
    background: var(--bg-elevated);
    box-shadow: none;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }

  :global(.footer-logo-link) {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  :global(.footer-logo-link:focus-visible) {
    outline: 2px solid color-mix(in srgb, var(--color-primary) 72%, transparent);
    outline-offset: 6px;
  }

  .footer-logo {
    height: 34px;
    width: auto;
  }

  .footer-logo--light {
    display: var(--logo-light-display);
  }

  .footer-logo--dark {
    display: var(--logo-dark-display);
  }

  .footer-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 8px;
  }

  :global(.footer-nav-button) {
    min-height: 42px;
  }

  .footer-bottom {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid var(--border);
    padding-top: 16px;
  }

  .footer-copy,
  .footer-note {
    margin: 0;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.5;
    font-weight: 600;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
    min-width: 0;
  }

  .footer-filing {
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.5;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .footer-filing:hover {
    color: var(--text-strong);
    text-decoration: underline;
  }

  .footer-filing:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-primary) 70%, transparent);
    outline-offset: 3px;
    border-radius: 4px;
    color: var(--text-strong);
  }

  .footer-note {
    text-align: right;
  }

  @media (min-width: 769px) {
    .site-footer {
      padding-bottom: 56px;
    }
  }

  @media (max-width: 840px) {
    .site-footer {
      padding: 36px 16px 132px;
    }

    .footer-panel {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 20px 18px 18px;
      border-radius: 22px;
    }

    .footer-bottom {
      gap: 6px;
      padding-top: 14px;
    }

    .footer-legal {
      flex-direction: row;
      flex-wrap: wrap;
      column-gap: 8px;
      row-gap: 4px;
    }
  }

  @media (max-width: 480px) {
    :global(.footer-nav-button) {
      width: 48%;
    }
  }
  @media (max-width: 360px) {
    :global(.footer-nav-button) {
      width: 100%;
    }
  }
</style>
