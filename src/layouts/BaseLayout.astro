---
export interface Props {
  lang?: string;
  title: string;
  description?: string;
  image?: string;
}

const {
  lang = 'zh-cn',
  title,
  image = '/images/logo/Type=Square, Mode=Light, Monochrome=False.png',
} = Astro.props;

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PageLoader from '../components/layout/PageLoader.astro';
import PwaHead from '../components/PwaHead.astro';
import AuthModal from '../features/auth/AuthModal.astro';
import { locales, defaultLocale, t } from '../i18n/index';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

const safeLang = locales.includes(lang as any) ? lang : defaultLocale;
const description = Astro.props.description ?? t(safeLang, 'seo.homeDescription');
const currentPath = Astro.url.pathname;
const pageTitle = title.includes('RinLit') ? title : `${title} — RinLit`;
const siteBase = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteBase).href;
const imageUrl = new URL(image, siteBase).href;
// Open Graph 要求 locale 使用 language_REGION 格式（下划线）
const ogLocale = safeLang === 'zh-cn' ? 'zh_CN' : 'en_US';
// 去掉路径中的语言前缀，用于生成各语言版本的 hreflang 链接
const pathWithoutLang = currentPath.replace(/^\/(zh-cn|en)(?=\/|$)/, '');
const alternateLinks: { hreflang: string; href: string }[] = locales.map((locale) => ({
  hreflang: locale,
  href: new URL(`/${locale}${pathWithoutLang}`, siteBase).href,
}));
alternateLinks.push({
  hreflang: 'x-default',
  href: new URL(`/${defaultLocale}${pathWithoutLang}`, siteBase).href,
});
---

<!doctype html>
<html lang={safeLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="light dark" />
    <meta name="keywords" content={t(safeLang, 'seo.keywords')} />
    <link rel="canonical" href={canonicalUrl} />
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RinLit" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <ClientRouter />  

    <script is:inline>
      (function () {
        try {
          var root = document.documentElement;
          // Mark standalone launches (installed PWA) so CSS can react to it
          // without relying on display-mode media queries alone.
          if (
            window.matchMedia('(display-mode: standalone)').matches ||
            window.navigator.standalone === true
          ) {
            root.classList.add('is-standalone');
          }
          var saved = localStorage.getItem('rinlit:theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var mode = saved ? saved : (prefersDark ? 'dark' : 'light');
          root.classList.toggle('dark', mode === 'dark');
          root.classList.toggle('light', mode === 'light');
          root.style.colorScheme = mode;
        } catch (e) {}
      })();
    </script>

    <title>{pageTitle}</title>

    <link rel="icon" href="/favicon/light.ico" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon/dark.ico" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon/light.ico" />

    <PwaHead lang={safeLang} />
  </head>
  <body class="min-h-screen bg-light text-dark font-sans">
    <div class="site-header-mask site-header-mask--top" aria-hidden="true"></div>
    <div class="site-header-mask site-header-mask--bottom" aria-hidden="true"></div>
    <Header currentPath={currentPath} lang={safeLang} transition:persist />
    <main class="site-main">
      <div class="page-transition-container">
        <slot />
      </div>
    </main>
    <Footer lang={safeLang} />
    <PageLoader />
    <AuthModal lang={safeLang} />
  </body>
</html>

<style>
  /* 移动端底部导航为固定定位，正文需要预留高度 + 手势条安全区 */
  .site-main {
    padding-bottom: calc(7rem + env(safe-area-inset-bottom, 0px));
  }

  @media (min-width: 769px) {
    .site-main {
      padding-bottom: 0;
    }
  }
</style>
